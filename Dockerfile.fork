# syntax=docker/dockerfile:1
#
# Fork image: builds the server + embedded
# client bundle from source and ships the SLIM runtime (no Chromium), matching
# upstream's Alpine layout so `docker-entrypoint.sh` works unchanged.
#
# Multi-stage:
#   1. client : Node, builds client_bundle/{client,base_fs} (rust-embed input)
#   2. server : Rust (Alpine/musl), builds the static `silverbullet` binary
#   3. runtime: Alpine, the upstream slim image plus the fresh binary
#
# For the headless-Chrome runtime API, build `Dockerfile.runtime-api` on top:
#   docker build -f Dockerfile.runtime-api --build-arg BASE_IMAGE=<this>:tag .

# ---------- stage 1: client bundle ----------
FROM node:22-alpine AS client
RUN apk add --no-cache git
WORKDIR /src
COPY package.json package-lock.json ./
RUN npm install --no-audit --no-fund \
 && (npm install-scripts approve esbuild @parcel/watcher || true) \
 && npm rebuild esbuild @parcel/watcher || true
COPY . .
RUN npm run build

# ---------- stage 2: server binary (static musl) ----------
FROM rust:alpine AS server
RUN apk add --no-cache musl-dev
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY bin ./bin
COPY server ./server
COPY server-common ./server-common
COPY server-merge ./server-merge
COPY server-runtime-chrome ./server-runtime-chrome
COPY --from=client /src/client_bundle ./client_bundle
# `build.rs` reads `../../version.json` (relative to `bin/silverbullet`) to
# inject SB_VERSION, the value the server reports to clients and the client
# bundle compares against its own to decide whether to show the "new version"
# banner. Stage 1 generates it while building the client, so take it from there
# — without it build.rs falls back to `0.0.0` and the banner never clears.
COPY --from=client /src/version.json ./version.json
# The version stamp changes every build, so this step never comes from the
# layer cache. Cache mounts keep the crate registry and `target/` across
# builds instead, so only changed crates recompile. `target/` is a cache mount
# and is not part of the layer, hence copying the binary out.
RUN --mount=type=cache,id=sb-cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=sb-cargo-git,target=/usr/local/cargo/git \
    --mount=type=cache,id=sb-cargo-target,target=/src/target \
    cargo build --release -p silverbullet --bin silverbullet \
 && cp target/release/silverbullet /silverbullet

# ---------- stage 3: runtime (upstream slim layout) ----------
FROM alpine:latest

RUN apk add --no-cache git curl bash tini openssh-client

# SB_FOLDER is resolved by the entrypoint to /data (or legacy /space).
ENV SB_HOSTNAME=0.0.0.0 \
    SB_PORT=3000
EXPOSE 3000
HEALTHCHECK CMD curl --fail "http://localhost:$SB_PORT/.instance" || exit 1

# Remove stock accounts so arbitrary PUID/PGID values cannot collide.
RUN echo "" > /etc/group && echo "root:x:0:0:root:/root:/bin/sh" > /etc/passwd

COPY docker-entrypoint.sh /docker-entrypoint.sh
COPY --from=server /silverbullet /silverbullet
RUN chmod +x /silverbullet /docker-entrypoint.sh

ENTRYPOINT ["/sbin/tini", "--", "/docker-entrypoint.sh"]
